# Copia este archivo como .env y arranca con: npm start (src/config.js lo lee solo)
PORT=4000

# Debe ser el mismo valor que usa ms-usuarios
# (en ms-usuarios/docker-compose.local.yml es secreto_local_cambiar)
JWT_SECRET=secreto_local_cambiar

# Fuera de Docker los servicios están en localhost; dentro, por su nombre (http://ms-usuarios:3004)
USUARIOS_URL=http://localhost:3004
CURSOS_URL=http://localhost:8081
EVALUACIONES_URL=http://localhost:8083
NOTIFICACIONES_URL=http://localhost:8004

# Tiempo límite para ms-evaluaciones (ms). Pide el curso a ms-cursos la primera vez y puede tardar.
EVALUACIONES_TIMEOUT_MS=15000

CORS_ORIGIN=http://localhost:5173
