# Copia este archivo como .env y cambia los valores.
PORT=3004

# Base de datos (dentro de Docker DB_HOST=db_usuarios y DB_PORT=5432)
DB_HOST=localhost
DB_PORT=5434
POSTGRES_DB=usuarios_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# Debe ser el mismo valor que usa el api-gateway
JWT_SECRET=cambia_este_secreto

# RabbitMQ (dentro de Docker: amqp://lms:lms123@rabbitmq:5672)
RABBIT_URL=amqp://lms:lms123@localhost:5672
RABBIT_EXCHANGE=lms.eventos.exchange

# ms-cursos (dentro de Docker: http://ms-cursos:8081)
CURSOS_URL=http://localhost:8081
CURSOS_TIMEOUT_MS=3000

# Administrador inicial, se crea solo si no existe ninguno
ADMIN_EMAIL=admin@unl.edu.ec
ADMIN_PASSWORD=admin123
